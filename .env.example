# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://your-frontend.railway.app

# ─── AI Provider (Google Gemini — FREE) ───────────────────────────────────────
AI_API_KEY=AIza...your-gemini-key
AI_MODEL=gemini-2.0-flash
AI_BASE_URL=https://generativelanguage.googleapis.com

# ─── Database (Railway PostgreSQL plugin sets this automatically) ─────────────
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# ─── Redis / Valkey ───────────────────────────────────────────────────────────
#
# URL resolution precedence (highest to lowest):
#   1. REDIS_URL   — set automatically by Railway's Redis plugin
#   2. VALKEY_URL  — for self-hosted Valkey or other providers
#   3. Default     — redis://localhost:6379 (local dev)
#
# You only need to set one. On Railway, neither needs to be set manually.
#
REDIS_URL=redis://default:password@host:6379      # Railway (auto-set)
# VALKEY_URL=redis://default:password@host:6379   # Self-hosted alternative
VALKEY_HOST=localhost
VALKEY_PORT=6379

# ─── File Retention ───────────────────────────────────────────────────────────
FILE_RETENTION_INPUT_HOURS=24    # Hours to keep uploaded input files (default: 24)
FILE_RETENTION_OUTPUT_HOURS=2    # Hours to keep processed output files (default: 2)
FILE_CLEANUP_CRON=0 3 * * *      # Cron schedule (default: daily at 03:00)
                                  # Example: */30 * * * * = every 30 minutes

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=20    # Max requests per IP per TTL window on /api/jobs/submit
RATE_LIMIT_TTL=60    # TTL window in seconds
