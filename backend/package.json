    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/throttler": "^5.1.2",
    "@prisma/client": "^5.7.1",
    "axios": "^1.6.5",
    "bullmq": "^5.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cron": "^4.4.0",
    "exceljs": "^4.4.0",
    "ioredis": "^5.3.2",
    "multer": "^1.4.5-lts.1",
