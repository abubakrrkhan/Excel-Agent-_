# ── Stage 1: Dependencies (all — needed for build + prisma generate) ──────
# Built with: docker buildx build --platform linux/arm64,linux/amd64
# For Oracle Cloud Ampere A1 (ARM64): use --platform linux/arm64
FROM --platform=$BUILDPLATFORM node:20-alpine AS deps

WORKDIR /app

COPY backend/package*.json ./
RUN npm ci

# ── Stage 2: Build ─────────────────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM node:20-alpine AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY backend/ .

# Generate Prisma client for the target platform
RUN npx prisma generate

# Compile TypeScript
RUN npm run build

# ── Stage 3: Production deps (runtime only, no dev tools) ─────────────────
FROM --platform=$TARGETPLATFORM node:20-alpine AS prod-deps

WORKDIR /app

COPY backend/package*.json ./
RUN npm ci --omit=dev

# ── Stage 4: Production runner ─────────────────────────────────────────────
FROM --platform=$TARGETPLATFORM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Compiled JS
COPY --from=builder /app/dist ./dist

# Production node_modules (no dev tools)
COPY --from=prod-deps /app/node_modules ./node_modules

# Prisma schema for migrations
COPY --from=builder /app/prisma ./prisma

# Prisma generated client (binary + JS)
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

# Prisma CLI binary — needed so the initContainer can run `prisma migrate deploy`.
# prisma is a devDependency, so it is NOT in prod-deps. We copy it explicitly
# from the full builder node_modules to keep the runner image lean while still
# allowing the migration initContainer to work.
COPY --from=builder /app/node_modules/prisma ./node_modules/prisma
COPY --from=builder /app/node_modules/@prisma/engines ./node_modules/@prisma/engines

COPY backend/package.json ./

# Upload directory — must match the PVC mountPath in the K8s manifest
RUN mkdir -p uploads && chown -R appuser:appgroup /app

USER appuser

EXPOSE 3001

CMD ["node", "dist/main.js"]
